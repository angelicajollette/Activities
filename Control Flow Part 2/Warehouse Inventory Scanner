import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int[][] warehouse = {
            {7, 12, -1},
            {19,-1, 2},
            {-1, 5, 13},
        };

        int choice;

        do {
            System.out.println("WAREHOUSE INVENTORY");
            System.out.println("CHOOSE A DESIRED NUMBER");
            System.out.println("(1) Display inventory");
            System.out.println("(2) Calculate total inventory");
            System.out.println("(3) Find critically low shelf");
            System.out.println("(4) Restock a shelf");
            System.out.println("(5) BACK");
            System.out.print("Enter: ");
            choice = input.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("\nWarehouse Inventory:");

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                System.out.print("Damaged\t");
                                continue;
                            }
                            System.out.print(warehouse[i][j] + "\t");
                        }
                        System.out.println();
                    }
                    break;

                case 2:
                    int total = 0;

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                continue;
                            }
                            total += warehouse[i][j];
                        }
                    }

                    System.out.println("Total inventory: " + total);
                    break;

                case 3:
                    boolean found = false;

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                continue;
                            }

                            if (warehouse[i][j] <= 2) {
                                System.out.println("Critically low shelf count");
                                System.out.println("Rows: " + i);
                                System.out.println("Columns: " + j);
                                System.out.println("No. of Items: " + warehouse[i][j]);
                                found = true;
                                break;
                            }
                        }

                        if (found) {
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("No critically low shelf found.");
                    }
                    break;

                case 4:
                    System.out.print("Enter row (0-2): ");
                    int row = input.nextInt();

                    System.out.print("Enter column (0-2): ");
                    int col = input.nextInt();

                    if (row < 0 || row >= warehouse.length ||
                        col < 0 || col >= warehouse[row].length) {
                        System.out.println("Opps! Invalid shelf location");
                        break;
                    }

                    if (warehouse[row][col] == -1) {
                        System.out.println("This shelf is damaged and cannot be restocked");
                        break;
                    }

                    int amount;

                    while (true) {
                        System.out.print("Enter items to add: ");
                        amount = input.nextInt();

                        if (amount > 0) {
                            break;
                        }

                        System.out.println("Opps! Invalid amount");
                    }

                    warehouse[row][col] += amount;
                    System.out.println("Shelf restocked success");
                    System.out.println("New item count: " + warehouse[row][col]);
                    break;

                case 5:
                    System.out.println("BACK");
                    break;

                default:
                    System.out.println("Opps! Try again");
            }

        } while (choice != 5);
    }
}
